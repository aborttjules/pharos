{
  "name": "pharos-agent",
  "version": "2.0.0",
  "description": "Pharos — Post-execution trade observation infrastructure for Solana AI agents. WATCHER_MODE_ONLY.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "dev:dashboard": "cd dashboard && npm run dev",
    "start:all": "concurrently \"npm run dev\" \"npm run dev:dashboard\"",
    "test": "node --experimental-vm-modules dist/tests/run.js",
    "db:migrate": "npx prisma migrate dev --schema=db/schema.prisma",
    "db:generate": "npx prisma generate --schema=db/schema.prisma",
    "db:studio": "npx prisma studio --schema=db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@solana/web3.js": "^1.95.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "telegraf": "^4.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.4.5"
  }
}
